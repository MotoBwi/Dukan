NODE_ENV=development
PORT=4000

# --- Database (use a dedicated low-privilege user; never commit real values) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dukan_app
DB_PASSWORD=change_me
DB_NAME=dukan
# Encrypt + verify the database connection (pick one):
#   DB_SSL=true                        verify against the system CAs
#   DB_SSL_CA=certs/db-ca.pem          verify against this CA file
#   DB_SSL_FINGERPRINT=AA:BB:...       pin the server certificate (sha256), for servers without a public CA
# DB_SSL=true

# --- Auth (the server REFUSES to start with short/placeholder secrets) ---
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Browser access ---
# Explicit origins only (comma separated). The refresh cookie is SameSite=Strict, so in production the
# app and the API must share a site (e.g. app.shop.com + api.shop.com).
CORS_ORIGIN=http://localhost:5173
# Set when running behind a reverse proxy / load balancer (number of proxies, e.g. 1) so rate limits use real IPs.
# TRUST_PROXY=1
# The refresh cookie is Secure (HTTPS-only) automatically when NODE_ENV=production; override with COOKIE_SECURE=true/false.

# --- SMTP for reminder emails (reminders stay pending until these are set) ---
# Port 587 = STARTTLS (standard). Use 465 with SMTP_SECURE=true for implicit TLS.
# Put the password in double quotes if it contains a # character.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dukan <no-reply@example.com>"
MAX_EMAILS_PER_HOUR=60
# A copy of every sent mail is filed in the mailbox's Sent folder over IMAP (same login).
# Optional overrides: IMAP_HOST (defaults to SMTP_HOST), IMAP_PORT (993), IMAP_SECURE (true), IMAP_SENT_FOLDER
# IMAP_CA_FILE: path to a PEM certificate to trust for IMAP only, when the IMAP server uses a self-signed cert.
# IMAP_CA_FILE=certs/mail.example.com-imap.pem

# --- Printed on invoices (all optional) ---
SHOP_NAME=YOUR SHOP NAME
SHOP_ADDRESS=Shop address line, City - 700000
SHOP_PHONE=98765 43210
SHOP_GSTIN=
SHOP_TERMS=Thank you for your business!
